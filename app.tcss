Screen {
    background: #0f1420;
}

/* Header & Footer */
Header, Footer {
    background: #0a0c10;
    color: #ffffff;
    border: none;
}

/* ── Brand (Logo) ── */
#brand {
    width: 100%;
    height: 9;

    content-align: center middle;

    color: #5b8af5;
    text-style: bold;

    margin-top: 1;
}

/* Subtitle text */
#subtitle {
    color: #6b7a99;
    content-align: center middle;
}

/* ── Menu Container ── */
#menu-container {
    align: center top;
}

#menu {
    width: 50%;
    margin-top: 2;
    background: #0f172a;
    border: round #1e293b;
    padding: 1;
}

#menu > .option-list--option {
    color: #94a3b8;
    padding: 0 1;
}

#menu > .option-list--option-highlighted {
    background: transparent;
    color: #e2e8f0;
    text-style: bold;
}
