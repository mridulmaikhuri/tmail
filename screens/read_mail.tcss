Screen {
    color: #ffffff;
    background: #0f1420;
}

/* ── Mail List Panel ── */
MailList {
    border-right: solid #2a344a;
}

/* Inbox Title */
#inbox {
    color: #5b8af5;
    text-style: bold;
    text-align: center;
}

/* Header Row */
#header_row {
    background: #182242;
    text-style: bold;
    height: 2;
}

/* ── Mail Rows ── */
MailRow {
    background: transparent;
}

MailRow:hover {
    background: #18213d;
}

/* Selected item */
ListItem.--highlight {
    background: #151a2a;
    border-left: solid #5b8af5;
}

.col {
    padding: 0 1;
}

/* Serial number */
.no {
    width: 8;
}

/* Sender */
.sender {
    width: 30;
}

/* Subject */
.subject {
    width: 60;
}

/* Date */
.date {
    width: 30;
}

MailList.compact .no {
    width: 6;
}

MailList.compact .sender {
    width: 15;
}

MailList.compact .subject {
    width: 30;
}

MailList.compact .date {
    width: 15;
}

/* ── ListView ── */
ListView {
    background: transparent;
}

/* ── Preview Pane ── */
PreviewMail {
    width: 0;
    height: 1fr;

    background: #0f1420;
    border-left: solid #2a344a;

    display: none;
}

/* 50–50 split */
PreviewMail.show {
    width: 1fr;
    display: block;
}

MailList.compact {
    width: 1fr;
}

/* ── Preview Scroll ── */

/* Title */
#title {
    color: #5b8af5;
    text-style: bold;
    margin-bottom: 1;
    text-align: center;
}

/* ── Metadata ── */
#metadata {
    background: #141a2e;
    border: round #2a344a;
    height: auto;
    padding: 1;
    margin-bottom: 1;
}

/* Metadata text */
#metadata Static {
    content-align: left middle;
}

/* ── Body ── */

#body-container {
    border: round #2a344a;
    padding: 1;
    height: auto;
}