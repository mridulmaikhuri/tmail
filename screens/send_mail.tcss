/* ── Wrapper (center screen) ── */
#compose-wrapper {
    width: 100%;
    height: 1fr;
    align: center middle;
}

#title {
    margin-top: 1;
    text-align: center;
}

/* ── Main Card ── */
#compose-card {
    width: 80%;
    padding: 2;
    background: #0f1218;
    border: round #2a3050;
    layout: vertical;
    align: center middle;
}

/* ── Title ── */
#title {
    color: #5b8af5;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

/* ── Input Groups ── */
.input-group {
    layout: vertical;
    margin-bottom: 1;
}

/* Labels */
.label {
    color: #6b7a99;
    text-style: bold;
    margin-bottom: 0;
}

/* Inputs */
Input, TextArea {
    background: #0a0c10;
    border: round #2a3050;
    color: #e2e8f0;
    padding: 0 1;
}

TextArea {
    height: 10;
}

/* Focus state */
Input:focus, TextArea:focus {
    border: round #5b8af5;
}

/* ── Buttons ── */
#buttons {
    margin-top: 2;
    align: right middle;
}

/* ── Base Button ── */
Button {
    padding: 0 3;
    width: auto;
    min-width: 0;
    border: round #2a3050;
    background: #0a0c10;
    color: #cbd5f5;
    text-style: bold;
    transition: background 200ms, border 200ms, color 200ms;
}

/* ── Primary (Send) ── */
.btn-primary {
    background: #2563eb;
    border: round #3b82f6;
    color: #ffffff;
}

/* Hover */
.btn-primary:hover {
    background: #3b82f6;
    border: round #60a5fa;
}

/* ── Secondary (Cancel) ── */
.btn-secondary {
    background: #111827;
    border: round #374151;
    color: #cbd5f5;
}

/* Hover */
.btn-secondary:hover {
    background: #1f2937;
    border: round #4b5563;
    color: #ffffff;
}

/* ── Focus (keyboard navigation) ── */
Button:focus {
    border: round #5b8af5;
}

/* Optional: subtle emphasis for primary on focus */
.btn-primary:focus {
    border: round #7aaaff;
}