Screen {
    background: #0a0c10;
}

/* ── Header / Footer ── */
Header, Footer {
    background: #0a0c10;
    color: #ffffff;
    border: none;
}

#mail-container {
    margin: 1;
}

/* ── Title ── */
#title {
    color: #5b8af5;
    text-style: bold;
}

/* ── Metadata (card style) ── */
#metadata {
    background: #141a2e;
    border: round #2a344a;
    padding: 1 2;
    margin-bottom: 1;
    height: auto;
}

/* Metadata text */
#metadata Static {
    color: #ffffff;
}

/* ── Email Body ── */
#body {
    color: #ffffff;
    padding: 1 2;
    margin-bottom: 1;
    background: #0f1420;
    border: round #2a344a;
}

/* ── Attachments ── */
#attachment-list {
    margin-top: 1;
    margin-bottom: 1;
    padding: 0 1;
    border: round #2a344a;
    background: #0f1420;
    height: auto;
}

/* Individual attachment */
#attachment-list > ListItem {
    padding: 1 1;
    color: #ffffff;
}

/* Highlighted attachment */
#attachment-list > ListItem.--highlight {
    background: #141a2e;
    border-left: solid #5b8af5;
}

/* No attachment text */
#no-attachment {
    color: #ffffff;
    margin-top: 1;
    margin-bottom: 1;
    padding: 0 1;
    background: #0f1420;
    border: round #2a344a;
    content-align: left middle;
}

/* ── Link ── */
#link {
    margin-top: 1;
    padding: 0 1;
    color: #5b8af5;
    text-style: bold;
    background: #0f1420;
    border: round #2a344a;
    content-align: center middle;
    text-align: center;
}

#link:hover {
    background: #141a2e;
    border: round #5b8af5;
    color: #ffffff;
}

#link:focus {
    background: #141a2e;
    border: round #5b8af5;
    color: #ffffff;
}

/* Optional hover effect */
#link:hover {
    text-style: underline;
}

#metadata,
#body,
#attachment-list {
    border: round #2a344a;
    background: #0f1420;
}